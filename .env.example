APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Require email OTP verification during registration. Set to false to disable.
OTP_REGISTRATION=true

# Reverse proxy IPs/CIDRs (comma separated). Leave empty when not behind a proxy.
TRUSTED_PROXIES=


# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=drastha_learning
DB_USERNAME=root
DB_PASSWORD=

# ==========================================================================
# SHARED HOSTING (Hostinger / cPanel) - LEAVE THESE UNCOMMENTED
# ==========================================================================
# Shared hosting typically does NOT have a local Redis/Memcached server.
# Use database driver for session & cache, and 'sync' for queue to avoid
# "Connection refused [tcp://127.0.0.1:6379]" errors on boot.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=strict

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Use 'database' for queued jobs (or 'sync' for small workloads).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# MEMCACHED_HOST=127.0.0.1

# Disabled on shared hosting (no local Redis service).
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# ==========================================================================
# LOCAL DOCKER (Sail) - UNCOMMENT THE BLOCK BELOW INSTEAD IF USING DOCKER
# ==========================================================================
# SESSION_DRIVER=redis
# CACHE_STORE=redis
# QUEUE_CONNECTION=sync
# REDIS_CLIENT=phpredis
# REDIS_HOST=redis
# REDIS_PASSWORD=null
# REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
