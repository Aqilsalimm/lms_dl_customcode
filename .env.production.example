APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://drasthalearning.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Require email OTP verification during registration. Set to false to disable.
OTP_REGISTRATION=true

# Reverse proxy IPs/CIDRs (comma separated). Leave empty when not behind a proxy.
TRUSTED_PROXIES=*


# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=drastha_learning
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=drastha_lms_

MEMCACHED_HOST=127.0.0.1

# ----------------------------------------------------------------------
# REDIS CLIENT SELECTION
# ----------------------------------------------------------------------
#   phpredis  = Native C extension (FAST but requires ext-redis installed
#               on the server. Many shared hosts DO NOT have it.)
#   predis    = Pure-PHP client (slower ~20% but works everywhere).
#
# If you are on shared hosting (Hostinger, Niagahoster, etc.) and see:
#   "Unable to load dynamic library 'redis' (...)"
# then set this to `predis` and clear config cache.
# ----------------------------------------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Read timeout (seconds) for individual Redis operations. Prevents a slow
# Redis from tying up a PHP-FPM worker indefinitely on shared hosting.
REDIS_READ_TIMEOUT=1.5
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
